{
  "name": "web-sdk-pp-lcnet-x1-0-doc-ori",
  "version": "0.1.2",
  "description": "Browser-first PP-LCNet document orientation SDK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenmohan123/web-sdk-PP-LCNet_x1_0_doc_ori.git"
  },
  "license": "Apache-2.0",
  "homepage": "https://chenmohan123.github.io/web-sdk-PP-LCNet_x1_0_doc_ori/",
  "keywords": [
    "onnx",
    "onnxruntime-web",
    "document",
    "orientation",
    "paddlepaddle"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "unpkg": "./dist/browser-global.global.js",
  "jsdelivr": "./dist/browser-global.global.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser-global": "./dist/browser-global.js",
    "./inference.worker.js": "./dist/inference.worker.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && node ../../scripts/copy-model-to-dist.mjs",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "onnxruntime-web": "1.27.0"
  }
}
