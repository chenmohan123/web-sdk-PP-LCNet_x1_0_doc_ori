{
  "name": "web-sdk-pp-lcnet-x1-0-doc-ori",
  "version": "0.1.0",
  "description": "Browser-first PP-LCNet document orientation SDK",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "unpkg": "./dist/browser-global.global.js",
  "jsdelivr": "./dist/browser-global.global.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser-global": "./dist/browser-global.js",
    "./inference.worker.js": "./dist/inference.worker.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "onnxruntime-web": "1.27.0"
  }
}
